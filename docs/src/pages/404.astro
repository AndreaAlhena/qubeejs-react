---
/**
 * The 404 page, after the mockup: the bee, the joke, and the way back.
 * Standalone like the home page; astro.config.mjs disables Starlight's own 404
 * route so this one is served.
 */
import ThemeScript from '../components/ThemeScript.astro';
import '../styles/qubee-react.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>404 — no such route | qubeejs/react</title>
    <link href={`${base}/mark-react.png`} rel="icon" />
    <ThemeScript />
  </head>

  <body>
    <main>
      <img alt="" height="108" src={`${base}/mark-react.png`} width="168" />
      <p class="code">404 — NO SUCH ROUTE</p>
      <h1>This one didn't paginate</h1>
      <p class="lede">
        The bee flew past the last page. <code>hasNextPage()</code> would have said no.
      </p>
      <div class="cta">
        <a class="btn primary" href={`${base}/`}>Back to firstPage()</a>
        <a class="btn" href={`${base}/introduction/why-an-adapter/`}>Read the guide</a>
      </div>
    </main>

    <style is:global>
      * {
        box-sizing: border-box;
      }

      body {
        align-items: center;
        background: var(--qb-alt);
        color: var(--qb-text);
        display: flex;
        font-family: var(--qb-font-body);
        justify-content: center;
        margin: 0;
        min-height: 100vh;
        padding: 60px 22px;
        text-align: center;
      }

      main {
        max-width: 520px;
      }

      img {
        animation: qb-bob 5s ease-in-out infinite;
        display: block;
        filter: drop-shadow(0 18px 34px rgba(10, 165, 224, 0.26));
        height: auto;
        margin: 0 auto 26px;
        width: 168px;
      }

      @keyframes qb-bob {
        0%,
        100% {
          transform: translateY(0) rotate(-2deg);
        }

        50% {
          transform: translateY(-7px) rotate(2deg);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        img {
          animation: none;
        }
      }

      .code {
        color: var(--qb-accent-ink);
        font-family: var(--qb-font-mono);
        font-size: 13px;
        letter-spacing: 0.22em;
        margin: 0 0 14px;
      }

      h1 {
        font-family: var(--qb-font-display);
        font-size: 38px;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin: 0 0 14px;
      }

      .lede {
        color: var(--qb-muted);
        font-size: 16.5px;
        line-height: 1.6;
        margin: 0 0 30px;
        text-wrap: pretty;
      }

      .lede code {
        color: var(--qb-text);
        font-family: var(--qb-font-mono);
        font-size: 14px;
      }

      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
      }

      .btn {
        border: 1px solid var(--qb-border);
        border-radius: 9px;
        color: var(--qb-text);
        font-size: 14.5px;
        font-weight: 600;
        padding: 11px 20px;
        text-decoration: none;
      }

      .btn:hover {
        border-color: var(--qb-accent);
      }

      .btn.primary {
        background: var(--qb-accent);
        border-color: var(--qb-accent);
        color: #04141c;
      }

      .btn.primary:hover {
        background: var(--qb-accent-hi);
      }
    </style>
  </body>
</html>
