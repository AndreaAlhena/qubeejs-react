{
  "devDependencies": {
    "@astrojs/starlight": "^0.42.4",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.3.5",
    "esbuild": "^0.28.2",
    "react-router": "^8.4.0",
    "sharp": "^0.34.5",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  },
  "name": "@qubeejs/react-docs",
  "private": true,
  "scripts": {
    "build": "npm run generate && npm run check && astro build && node scripts/check-site.mjs --pending",
    "check": "tsc -p examples/tsconfig.json && node ../node_modules/vitest/vitest.mjs run --config examples/vitest.config.ts --passWithNoTests",
    "dev": "npm run generate && astro dev",
    "generate": "node scripts/generate-api.mjs && node scripts/generate-changelog.mjs && node scripts/generate-sizes.mjs",
    "preview": "astro preview"
  },
  "type": "module",
  "version": "0.0.0"
}
