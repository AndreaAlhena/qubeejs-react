{
  "author": {
    "name": "Andrea Tantimonaco",
    "url": "https://andreatantimonaco.me"
  },
  "description": "React hooks for @qubeejs/core: a query builder per component or per subtree, and lists whose state lives in the URL",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qubeejs/core": "^1.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-sort-json": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "homepage": "https://qubeejs-react.andreatantimonaco.me",
  "keywords": [
    "hooks",
    "pagination",
    "qubee",
    "query-builder",
    "react",
    "search-params",
    "url-state",
    "use-sync-external-store"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "name": "@qubeejs/react",
  "peerDependencies": {
    "@qubeejs/core": "^1.3.0",
    "react": "^18.3.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreaAlhena/qubeejs-react.git"
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.0"
}
